# MatchStake Environment Variables
# Copy this to .env and fill in values

# Deployer private key (NEVER commit this!)
PRIVATE_KEY=your_private_key_here

# OKLink API key for contract verification
OKLINK_API_KEY=your_oklink_api_key

# Network to deploy to (xlayer_testnet or xlayer_mainnet)
NETWORK=xlayer_testnet
